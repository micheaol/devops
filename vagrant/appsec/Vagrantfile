Vagrant.configure("2") do |config|
  config.hostmanager.enabled = true 
  config.hostmanager.manage_host = true
  
  
### Nginx VM ###
  config.vm.define "appsec" do |appsec|
    appsec.vm.box = "ubuntu/jammy64"
    appsec.vm.hostname = "appsec"
  appsec.vm.network "private_network", ip: "192.168.56.17"
  appsec.vm.provider "virtualbox" do |vb|
     vb.gui = true
     vb.memory = "10240"
   end
end
end

# vb.memory = "10240" => 10G memory space