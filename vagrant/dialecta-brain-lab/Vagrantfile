Vagrant.configure("2") do |config|
  config.hostmanager.enabled = true 
  config.hostmanager.manage_host = true
  
  
### Nginx VM ###
  config.vm.define "dialectaBrain" do |dialectaBrain|
    dialectaBrain.vm.box = "ubuntu/jammy64"
    dialectaBrain.vm.hostname = "dialectaBrain"
  dialectaBrain.vm.network "private_network", ip: "192.168.56.15"
  dialectaBrain.vm.provider "virtualbox" do |vb|
     vb.gui = true
     vb.memory = "10240"
   end
end
end

# vb.memory = "10240" => 10G memory space