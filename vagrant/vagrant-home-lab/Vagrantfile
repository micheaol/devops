Vagrant.configure("2") do |config|
  config.hostmanager.enabled = true 
  config.hostmanager.manage_host = true
  
  
### Nginx VM ###
  config.vm.define "dialecta" do |dialecta|
    dialecta.vm.box = "ubuntu/jammy64"
    dialecta.vm.hostname = "dialecta"
  dialecta.vm.network "private_network", ip: "192.168.56.11"
  dialecta.vm.provider "virtualbox" do |vb|
     vb.gui = true
     vb.memory = "10240"
   end
end
end

# vb.memory = "10240" => 10G memory space