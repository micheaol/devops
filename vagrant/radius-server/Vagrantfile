Vagrant.configure("2") do |config|
  config.hostmanager.enabled = true 
  config.hostmanager.manage_host = true
  
  
### Nginx VM ###
  config.vm.define "radius" do |radius|
    radius.vm.box = "ubuntu/jammy64"
    radius.vm.hostname = "radius"
  radius.vm.network "private_network", ip: "192.168.56.19"
  radius.vm.provider "virtualbox" do |vb|
     vb.gui = true
     vb.memory = "102400"
   end
end
end

# vb.memory = "10240" => 10G memory space